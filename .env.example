# Application PostgreSQL connection string
# Obtain this from the active database provider or deployment environment.
DATABASE_URL="postgresql://user:password@database-host:5432/application?sslmode=require"
NODE_ENV="production"
PORT="3000"
JSON_BODY_LIMIT="50mb"
# Recommended for production: run `prisma migrate deploy` as a Dokploy release
# step, then set this false on all web replicas.
MIGRATIONS_ON_BOOT="false"

# Set true only when the app is reached through a trusted reverse proxy such
# as Cloudflare. Leave false for direct/local access to prevent IP spoofing.
TRUST_PROXY="false"

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-64-char-random-secret-here"
JWT_REFRESH_SECRET="your-second-64-char-random-secret-here"

# Resend (email for password reset)
RESEND_API_KEY="re_..."
APP_URL="https://crm.dreamboxadvertising.co.zw"

# Cron security (optional — protects /api/cron/* from external abuse)
CRON_SECRET="your-random-cron-secret"
# Keep enabled on exactly one app replica when horizontally scaling. Disable
# on other replicas and invoke the protected cron routes from one scheduler.
CRON_SCHEDULER_ENABLED="true"

# Groq AI (existing)
GROQ_API_KEY="your-groq-api-key"

# Optional — custom User-Agent for Nominatim geocoding (defaults to DreamboxCRM/1.0)
NOMINATIM_USER_AGENT="DreamboxCRM/1.0 (your-email@example.com)"

# Cloudflare R2 (S3-compatible) storage for images, logos, and exports
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com/<bucket>"
R2_PUBLIC_URL="https://pub-<hash>.r2.dev"
R2_BUCKET_NAME="dreambox"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"

# Prefix used for infrastructure-level PostgreSQL snapshots.
DATABASE_BACKUP_PREFIX="<database-service-name>/database-backups/dreambox-production"

# REMOVED — no longer needed at runtime:
# VITE_SUPABASE_URL
# VITE_SUPABASE_ANON_KEY

# Optional — only set when re-running scripts/migrate-from-supabase.ts
# SUPABASE_URL="https://<project>.supabase.co"
# SUPABASE_ANON_KEY="ey..."
